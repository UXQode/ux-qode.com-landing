# HubSpot lead capture for the contact form (pages/api/contact.ts)
# Copy this file to .env.local and fill in your values, then restart `next dev`.

# --- CRM API (Deals) — required ---
# A HubSpot Private App access token.
# Create it in: Settings → Integrations → Private Apps → Create a private app.
# Required scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write
#   crm.objects.deals.read,    crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN=

# Optional — where new deals land. Defaults shown are HubSpot's standard sales pipeline.
# Find ids in: Settings → Objects → Deals → Pipelines (use the internal stage id).
HUBSPOT_DEAL_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled

# --- Tracking script (optional) ---
# Loads HubSpot analytics site-wide (pages/_app.tsx) and sets the hubspotutk
# cookie. Set to your HubSpot Hub / Portal ID. Leave blank to disable.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
